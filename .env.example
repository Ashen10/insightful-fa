# Public site URL — used by metadataBase, the sitemap absolute URLs,
# robots.txt's Sitemap line, and the Article JSON-LD canonical / publisher logo.
# Required in production; dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://insightfulfa.com

# Web3Forms access key — powers the Contact form submission (POST to
# api.web3forms.com). The key is public-safe by design (it only permits
# sending to the address registered with Web3Forms). Get it from web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# --- Chatbot: Azure AI Foundry + Azure AI Search --------------------------
# Server-only secrets (never exposed to the browser). Set these in the Vercel
# project settings (Production + Preview) as well as in .env.local for dev.
# The RAG index is built with: node scripts/build-chatbot-index.mjs
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=embed
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Read-only query key for the running app; the admin key is only needed by the
# index-builder script.
AZURE_SEARCH_QUERY_KEY=your-search-query-key
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=insightful-content
